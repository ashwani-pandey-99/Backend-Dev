<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Blog</title>
</head>
<body>
  <h1>Blog Posts</h1>

  <a href="/blog/new">Create New Post</a>

  <ul>
    <% posts.forEach((post) => { %>
      <li>
        <a href="/blog/<%= post.slug %>"><%= post.title %></a>
        <small>(<%= post.createdAt.toDateString() %>)</small>
      </li>
    <% }) %>
  </ul>

  <p><a href="/">Back to home</a></p>
</body>
</html>
