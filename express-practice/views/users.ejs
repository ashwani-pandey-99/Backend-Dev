<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>User Filter</title>
</head>
<body>
  <h1>User Filter</h1>

  <form method="get" action="/users">
    <label>
      Search by name:
      <input type="text" name="name" value="<%= filter %>" />
    </label>
    <button type="submit">Filter</button>
  </form>

  <ul>
    <% users.forEach((user) => { %>
      <li><strong><%= user.name %></strong> — <%= user.email %></li>
    <% }) %>
  </ul>

  <p><a href="/">Back to home</a></p>
</body>
</html>
